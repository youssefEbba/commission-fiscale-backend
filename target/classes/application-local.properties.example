# Copier ce fichier vers application-local.properties (ignoré par Git) pour vos surcharges locales.
# Exemples (décommenter / adapter) :
#
# spring.datasource.password=secret
# spring.jpa.hibernate.ddl-auto=none
# Désactiver la demande de correction « démo » adoptée au démarrage (ne supprime pas les lignes déjà en base MySQL).
# app.seed.demande-correction.enabled=false
#
# --- E-mail SMTP (Gmail) — mot de passe d'application Google uniquement dans ce fichier ---
# app.mail.enabled=true
# app.mail.from=votre@gmail.com
# app.mail.override-recipient=votre@gmail.com
# spring.mail.username=votre@gmail.com
# spring.mail.password=xxxx xxxx xxxx xxxx
# (host/port/TLS : déjà dans application.properties)
